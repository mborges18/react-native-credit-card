{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "removeComments": true,
    "noImplicitAny": true,
    "jsx": "react-native",
    "strict": true,
    "baseUrl": "./",
    "paths": {
      "react": ["./node_modules/@type/react"],
      "*": ["src/*"],
      "assets/*": ["assets/*"],
      "test/*": ["test/*"],
      "components": ["components/*"],
      "api": ["api/*"],
      "hooks": ["hooks/*"],
      "navigation": ["navigation/*"],
      "screens": ["screens/*"],
      "context": ["context/*"],
      "utils": ["utils/*"],
    }
  }
}
